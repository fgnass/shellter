<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Shellter</string>
	<key>CFBundleDisplayName</key>
	<string>Shellter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.3.0</string> <!-- x-release-please-version -->
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>A program in Shellter wants to use the microphone.</string>
	<key>NSCameraUsageDescription</key>
	<string>A program in Shellter wants to use the camera.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>A program in Shellter wants to control other apps.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>A program in Shellter wants to use Bluetooth.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>A program in Shellter wants to access your calendars.</string>
	<key>NSContactsUsageDescription</key>
	<string>A program in Shellter wants to access your contacts.</string>
	<key>NSRemindersUsageDescription</key>
	<string>A program in Shellter wants to access your reminders.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>A program in Shellter wants to access your photos.</string>
	<key>NSLocationUsageDescription</key>
	<string>A program in Shellter wants to use your location.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>A program in Shellter wants to use speech recognition.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.fgnass.shellter.sidebar-item</string>
			<key>UTTypeDescription</key>
			<string>Shellter sidebar item</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
